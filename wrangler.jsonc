{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jc-healthcheck",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"upload_source_maps": true,
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "HEALTH_STATE",
			"id": "ea25f6bd0cde40998248b89f1bc5bcf8"
		}
	],
	"vars": {
		"DESTINATION_EMAIL": "ivankrup2003@gmail.com"
	},
	"send_email": [
		{
			"name": "ALERT_EMAIL"
		}
	],
}